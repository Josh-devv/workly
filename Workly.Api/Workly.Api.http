  "role": "owner",
  "status": "pending",
  "expiresAt": "2026-10-26T00:00:00Z"
}

### Delete an organization invitation
DELETE http://localhost:5290/api/OrgInvitation/7a6a9018-4761-4f00-914c-1e11f27d6c80